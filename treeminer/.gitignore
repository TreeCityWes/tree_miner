**/build/
build-*/
**/vcpkg_installed/
# Anchored: the miner's runtime log files live at the working-directory root.
# An unanchored "log*" matches src/Logger.cpp on case-insensitive filesystems
# (WSL/NTFS, macOS) — that is how Logger.{h,cpp} were dropped from this fork.
/log*
__pycache__/
*.pyc
data/
node_modules/
web/dist/
*.tsbuildinfo
test-logs/
.benchmarks/
benchmark-results/
.claude/
.deps/
.venv/

# Local miner state and private configuration
config.txt
difficulty.cache
miner-runtime.log
treeminer-journal.db*
.env
.env.*
!.env.example
